<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Analyzers for every project">
        <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    </ItemGroup>

    <ItemGroup Label="Libraries">
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageVersion Include="MySqlConnector" Version="2.6.2" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageVersion Include="Testcontainers" Version="4.16.0" />
        <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>
</Project>
