<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Every package comes from nuget.org: a single source keeps restores the same on every machine and in CI -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
